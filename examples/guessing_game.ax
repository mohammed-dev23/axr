fn main() {
    println("Guess the number!");

    let secret_number : unt = random_from::[unt]((1 to unt)..(100 to unt));

    loop {
        let guess : unt = input::[unt]("Please input your guess: ");

        print("You guessed: ");
        println(guess);


        if guess < secret_number {
            println("Too small!");
        } else if guess > secret_number {
            println("Too big!");
        } else {
            println("You win!");
            stop;
        }
    }

    return;
}
