const SOME : int = 1000;

fn main() {
    let x : int = 1;
    let z : int  = 2;
    println x + z + SOME;

    let ~v = "any";
    v = "None";
    println v;

    let num1 : int = 8;
    let num2 : int = 9;
    let num_tot : int = num1 + num2;

    let some_chars : char = 'c';
    println some_chars;

    let v1 = "h";
    let v2 = "e";
    let v3 = "y";
    let v_full = v1 + v2 + v3;
    println v_full;
}
