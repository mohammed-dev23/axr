fn main() {
    println("      ---this is MaCalc---      ");
    println(" --basic binary calculater made in Axr-- ");

    loop {
        let n1 : int = input(">1>-enter an num: ")::[int];
        let n2 : int = input(">2>-enter an num: ")::[int];
        let op : str = input(">> enter a op you want to make (+ , - , / , *): ")::[str];


        if n1 == 0 or n2 == 0 or is_empty(op) {
            println(">>you have not entered a op kind please try again!");
            skip;
        }

        match trim(op) {
            "+" => {
                println(n1 + n2);
            },
            "-" => {
                println(n1 - n2);
            },
            "/" => {
                println(n1 / n2);
            },
            "*" => {
                println(n1 * n2);
            },
            _ => {
                println("unexpected op: " + op);
                stop;
            }
        }

        println("done!");
    }

    return;
}
