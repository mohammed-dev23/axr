fn main() {
    println("      ---this is MaCalc---      ");
    println(" --basic binary calculater made in Axr-- ");

    loop {
        let n1 : int = input::[int](">1>-enter an num: ");
        let n2 : int = input::[int](">2>-enter an num: ");
        let op : str = input::[str](">> enter a op you want to make (+ , - , / , *): ");


        if is_empty(op) {
            println(">>you have not entered a op kind please try again!");
            skip;
        }

        match op {
            "+" => {
                println(n1 + n2);
            },
            "-" => {
                println(n1 - n2);
            },
            "/" => {
                println(n1 / n2);
            },
            "*" => {
                println(n1 * n2);
            },
            _ => {
                println("unexpected op: " + op);
                stop;
            }
        }

        println("done!");
    }

    return;
}
